PORT=3000
NODE_ENV=development
# Orígenes separados por coma. El cliente iPad legacy se sirve en /ipad/ (mismo host).
CORS_ORIGIN=http://localhost:4200,https://d1jr8rgm5npiqn.cloudfront.net
# Origen del front para manifests PWA y links en mails
PUBLIC_APP_ORIGIN=https://d1jr8rgm5npiqn.cloudfront.net
JWT_SECRET=change-me-crc-dev

# Web Push (PWA / iOS con app en pantalla de inicio). Generar con:
# node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto VAPID: mailto:… o https://… (sin mail fijo, usá la URL del front)
VAPID_SUBJECT=https://d1jr8rgm5npiqn.cloudfront.net

# Email (opcional / fallback). Si cada local tiene email + contraseña en Administración,
# no hace falta SMTP global: se usa smtp.gmail.com con las credenciales del local.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remitente por defecto si el local no tiene email asignado
SMTP_FROM=

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=cash_register_closings
DB_SYNC=true

# Seed de locales/usuarios demo (admin@cierres.com / demo). Solo si lo necesitás en local.
# ENABLE_DEMO_SEED=true

# --- Variables adicionales usadas por docker-compose.yml en produccion (Lightsail) ---
MYSQL_ROOT_PASSWORD=change-me-root
ORIGIN_VERIFY=change-me-shared-secret


DB_SYNC=true DB_PASSWORD=ea045f8d76dc163f978cde7e634c347e10d907b5 DB_PORT=3306 DB_HOST=db DB_NAME=cash_register_closings DB_USER=crc_app

name: Deploy Backend

on:
  push:
    branches: [main]
  workflow_dispatch: {}

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Trigger deploy on Lightsail (SSH)
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.LIGHTSAIL_HOST }}
          username: ${{ secrets.LIGHTSAIL_USER }}
          key: ${{ secrets.LIGHTSAIL_SSH_KEY }}
          port: 22
          command_timeout: 15m
          script: echo "deploy triggered from GitHub Actions"