PORT=3000
NODE_ENV=development
# Orígenes separados por coma (CloudFront legacy + dominio custom). El cliente iPad legacy se sirve en /ipad/ (mismo host).
# Dev web: :4200. Expo Metro (ng serve native / Expo Go web): :8081. Sumá la IP LAN si probás desde el celu.
CORS_ORIGIN=http://localhost:4200,http://localhost:8081,https://d1jr8rgm5npiqn.cloudfront.net,https://cierres.perezcompany.com.ar
# Origen canónico del front para links en mails / deep links push
PUBLIC_APP_ORIGIN=https://cierres.perezcompany.com.ar
JWT_SECRET=change-me-crc-dev

# Google Sign-In (opcional). Client ID tipo "Aplicación web" de Google Cloud Console.
# Debe coincidir con googleClientId del front. Sin esto, el botón no funciona.
# GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# Web Push (PWA / iOS con app en pantalla de inicio). Generar con:
# node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto VAPID: mailto:… o https:… (sin mail fijo, usá la URL del front)
VAPID_SUBJECT=https://cierres.perezcompany.com.ar

# Email (opcional / fallback). Si cada local tiene email + contraseña en Administración,
# no hace falta SMTP global: se usa smtp.gmail.com con las credenciales del local.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remitente por defecto si el local no tiene email asignado
SMTP_FROM=

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=cash_register_closings
DB_SYNC=true

# Carpeta local para facturas / comprobantes de pago (PDF o foto)
UPLOADS_DIR=uploads
# Días que se conservan los archivos (cierres, facturas, comprobantes, CVs). 0 = no borrar.
UPLOADS_RETENTION_DAYS=365
# Cron diario de purga (5:00 hora Argentina por defecto)
UPLOADS_PURGE_CRON=0 5 * * *
UPLOADS_PURGE_TZ=America/Argentina/Buenos_Aires

# Gemini (opcional). Si hay clave, se usa para interpretar cartas / CV / facturas
# cuando el OCR local da mal resultado. Gratis en https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# Ante 503/alta demanda se reintenta y se prueban estos (coma-separados):
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-flash-latest

# Groq (opcional). Respaldo free si Gemini falla. https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b

# Seed de locales/usuarios demo (admin@cierres.com / demo). Solo si lo necesitás en local.
# ENABLE_DEMO_SEED=true

# Login «Ver demo» desde el front (admin de local + isDemo). Requiere seed o crea el usuario demo al primer uso.
# DEMO_LOGIN_ENABLED=true

# Secreto opcional para verificar el webhook de Deliverate. Si se define, el
# webhook exige ?token=<secreto> (o header x-webhook-secret) y se agrega a la
# URL registrada. Vacío = sin verificación (comportamiento actual).
# DELIVERATE_WEBHOOK_SECRET=

# Proxies delante de nginx que agregan IP a X-Forwarded-For (CloudFront = 1, directo = 0).
# Se usa para el rate limit por IP de login / PIN / rutas públicas.
# TRUSTED_PROXY_HOPS=1

# Swagger en /api/docs. Siempre activo fuera de producción; en producción solo con true.
# SWAGGER_ENABLED=false

# --- Variables adicionales usadas por docker-compose.yml en produccion (Lightsail) ---
MYSQL_ROOT_PASSWORD=change-me-root
ORIGIN_VERIFY=change-me-shared-secret
